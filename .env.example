TOKEN=MyBotToken
LOG_URL=https://logviewername.herokuapp.com/
GUILD_ID=1234567890
OWNERS=Owner1ID,Owner2ID,Owner3ID
DISABLE_AUTOUPDATES=true

# Mongo (docker stack) — optional; compose defaults below
MONGO_PORT=27048
MONGO_HOST_PORT=27048
MONGO_DATABASE=modmail_bot
MONGO_VOLUME_NAME=modmail-mongodb-data
# CONNECTION_URI is set by compose: mongodb://mongo:27048
# On server before first deploy: ./modmail-ports.sh setup-volume
